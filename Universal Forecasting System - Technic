### 1.2 Research Agent Configurations

Each research agent follows a consistent configuration pattern using the **Factory Pattern**.

**Base Configuration** (`src/agents/baseResearchAgent.ts`):

```typescript
export abstract class BaseResearchAgent {
  protected agentType: ResearchAgentType;
  protected runtime: IAgentRuntime;

  constructor(agentType: ResearchAgentType, runtime: IAgentRuntime) {
    this.agentType = agentType;
    this.runtime = runtime;
  }

  // Abstract method each agent must implement
  abstract executeResearch(query: ResearchQuery): Promise<ResearchResult>;

  // Shared confidence calculation logic
  protected calculateConfidence(
    sources: string[],
    dataQuality: number,
    recency: number
  ): number {
    let confidence = 0.5; // Base confidence

    // More sources increase confidence
    if (sources.length >= 5) confidence += 0.2;
    else if (sources.length >= 3) confidence += 0.1;

    // Data quality factor
    confidence += dataQuality * 0.3;

    // Recency factor (within last 30 days)
    confidence += recency * 0.2;

    return Math.min(confidence, 1.0);
  }

  // Shared source quality rating
  protected rateSourceQuality(url: string): number {
    const officialDomains = ['.gov', 'sec.gov', '.edu'];
    const peerReviewed = ['arxiv.org', 'scholar.google'];
    const industryReports = ['gartner.com', 'forrester.com', 'idc.com'];
    const newsOrgs = ['reuters.com', 'bloomberg.com', 'wsj.com'];

    if (officialDomains.some(d => url.includes(d))) return 1.0;
    if (peerReviewed.some(d => url.includes(d))) return 1.0;
    if (industryReports.some(d => url.includes(d))) return 0.9;
    if (newsOrgs.some(d => url.includes(d))) return 0.8;
    
    return 0.5; // Default for unknown sources
  }
}
```

