{
  "name": "uffp-mobile",
  "version": "1.0.0",
  "description": "Universal Forecasting & Fermi Problems - Mobile App",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "expo build:android --type apk",
    "build:android:bundle": "expo build:android --type app-bundle",
    "build:preview": "expo build:android --type apk --release-channel preview",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "validate-schema": "npx tsx scripts/validate-schema.ts",
    "validate-schema:all": "npx tsx scripts/validate-schema.ts --all",
    "test:schema": "npx tsx tests/schemaValidator.test.ts",
    "test:cli": "npx tsx tests/cliDriverCreation.test.ts",
    "test:all": "npm run test:schema && npm run test:cli",
    "test": "npm run test:all",
    "prepare": "husky",
    "test:link-preview": "npx tsx tests/linkPreview.test.ts",
    "test:backend": "npx tsx tests/backendIntegration.test.ts"
  },
  "dependencies": {
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.11.0",
    "eas-cli": "^16.32.0",
    "expo": "~54.0.32",
    "expo-status-bar": "~3.0.9",
    "nanoid": "^5.1.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "expo-dev-client": "^6.0.20",
    "husky": "^9.1.7",
    "prettier": "^3.0.0",
    "typescript": "~5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Replicant-Partners/uffp-mobile.git"
  },
  "keywords": [
    "forecasting",
    "fermi",
    "probability",
    "tetlock",
    "react-native",
    "expo"
  ],
  "author": "Replicant Partners",
  "license": "MIT",
  "private": true
}
