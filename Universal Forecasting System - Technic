### 6.2 Scheduler Implementation

**File**: `src/utils/researchScheduler.ts`

```typescript
export class ResearchScheduler {
  /**
   * Creates a new scheduled research task
   */
  static async createSchedule(
    runtime: IAgentRuntime,
    agentType: ResearchAgentType,
    query: ResearchQuery,
    schedule: ScheduleConfig,
    userId: string
  ): Promise<ScheduledResearch> {
    const id = uuidv4();
    const now = Date.now();
    const nextRun = this.calculateNextRun(schedule);

    const scheduledResearch: ScheduledResearch = {
      id,
      agentType,
      query,
      schedule,
      enabled: true,
      nextRun,
      results: [],
      createdAt: now,
      createdBy: userId,
    };

    // Store in database
    await this.saveSchedule(runtime, scheduledResearch);

    return scheduledResearch;
  }

  /**
   * Calculates the next run time based on schedule configuration
   */
  static calculateNextRun(schedule: ScheduleConfig): number {
    const now = new Date();

    switch (schedule.frequency) {
      case "daily": {
        const tomorrow = new Date(now);
        tomorrow.setDate(tomorrow.getDate() + 1);

        if (schedule.time) {
          const [hours, minutes] = schedule.time.split(":").map(Number);
          tomorrow.setHours(hours, minutes, 0, 0);
        } else {
          tomorrow.setHours(9, 0, 0, 0); // Default 9 AM
        }

        return tomorrow.getTime();
      }

      case "weekly": {
        const nextWeek = new Date(now);
        const currentDay = now.getDay();
        const targetDay = schedule.dayOfWeek ?? 1; // Default Monday

        // Calculate days until target day
        let daysUntil = targetDay - currentDay;
        if (daysUntil <= 0) daysUntil += 7;

        nextWeek.setDate(nextWeek.getDate() + daysUntil);

        if (schedule.time) {
          const [hours, minutes] = schedule.time.split(":").map(Number);
          nextWeek.setHours(hours, minutes, 0, 0);
        } else {
          nextWeek.setHours(9, 0, 0, 0);
        }

        return nextWeek.getTime();
      }

      case "monthly": {
        const nextMonth = new Date(now);
        const targetDay = schedule.dayOfMonth ?? 1; // Default 1st of month

        nextMonth.setMonth(nextMonth.getMonth() + 1);
        nextMonth.setDate(targetDay);

        if (schedule.time) {
          const [hours, minutes] = schedule.time.split(":").map(Number);
          nextMonth.setHours(hours, minutes, 0, 0);
        } else {
          nextMonth.setHours(9, 0, 0, 0);
        }

        return nextMonth.getTime();
      }

      default:
        throw new Error(`Unknown frequency: ${schedule.frequency}`);
    }
  }

  /**
   * Background task that executes due research schedules
   * Should be run every 5 minutes via cron job or similar
   */
  static async processDueSchedules(runtime: IAgentRuntime): Promise<void> {
    const dueSchedules = await this.getDueSchedules(runtime);

    for (const schedule of dueSchedules) {
      try {
        await this.executeScheduledResearch(runtime, schedule);
      } catch (error) {
        console.error(`Failed to execute schedule ${schedule.id}:`, error);
        // Continue with other schedules
      }
    }
  }

  /**
   * Executes a scheduled research task
   */
  private static async executeScheduledResearch(
    runtime: IAgentRuntime,
    schedule: ScheduledResearch
  ): Promise<void> {
    // Create agent
    const agent = ResearchAgentFactory.createAgent(
      schedule.agentType,
      runtime
    );

    // Execute research
    const result = await agent.executeResearch(schedule.query);

    // Store result (keep last 10)
    schedule.results.unshift(result);
    if (schedule.results.length > 10) {
      schedule.results = schedule.results.slice(0, 10);
    }

    // Update timestamps
    schedule.lastRun = Date.now();
    schedule.nextRun = this.calculateNextRun(schedule.schedule);

    // Save to database
    await this.updateSchedule(runtime, schedule);

    // Detect significant changes
    const hasSignificantChange = this.detectSignificantChange(
      schedule.results
    );

    if (hasSignificantChange) {
      await this.notifyUser(runtime, schedule, result);
    }
  }

  /**
   * Detects if latest result shows significant change from previous
   */
  private static detectSignificantChange(
    results: ResearchResult[]
  ): boolean {
    if (results.length < 2) return false;

    const latest = results[0];
    const previous = results[1];

    // Compare confidence scores
    const confidenceDiff = Math.abs(latest.confidence - previous.confidence);
    if (confidenceDiff > 0.2) return true;

    // For sentiment data, check overall sentiment change
    const latestSentiment = latest.structuredData?.find(
      (d) => d.type === "sentiment"
    );
    const previousSentiment = previous.structuredData?.find(
      (d) => d.type === "sentiment"
    );

    if (latestSentiment && previousSentiment) {
      const sentimentChange = Math.abs(
        (latestSentiment.data as any).overall -
        (previousSentiment.data as any).overall
      );
      if (sentimentChange > 0.15) return true; // 15% change
    }

    // For time series, check if latest value is outside previous range
    const latestTS = latest.structuredData?.find(
      (d) => d.type === "time_series"
    );
    const previousTS = previous.structuredData?.find(
      (d) => d.type === "time_series"
    );

    if (latestTS && previousTS) {
      const latestValue = (latestTS.data as any).dataPoints.slice(-1)[0]
        ?.value;
      const previousValues = (previousTS.data as any).dataPoints.map(
        (p: any) => p.value
      );
      const previousMin = Math.min(...previousValues);
      const previousMax = Math.max(...previousValues);

      if (latestValue < previousMin || latestValue > previousMax) {
        return true; // Outside previous range
      }
    }

    return false;
  }

  /**
