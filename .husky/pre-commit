#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run schema validation tests before allowing commit
echo "🔍 Running schema validation tests..."

npm run test:schema
SCHEMA_EXIT=$?

npm run test:cli
CLI_EXIT=$?

npm run test:state
STATE_EXIT=$?

if [ $SCHEMA_EXIT -ne 0 ] || [ $CLI_EXIT -ne 0 ] || [ $STATE_EXIT -ne 0 ]; then
  echo ""
  echo "❌ Validation tests failed!"
  echo "Please fix the errors before committing."
  echo ""
  exit 1
fi

echo "✅ All validation tests passed!"
echo ""
