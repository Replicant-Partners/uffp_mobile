export class ResearchAgentFactory {
  static createAgent(
    agentType: ResearchAgentType,
    runtime: IAgentRuntime
  ): BaseResearchAgent {
    switch (agentType) {
      case "market_tam_sizing":
        return new MarketTamSizingAgent(runtime);
      case "sentiment_tracking":
        return new SentimentTrackingAgent(runtime);
      case "competitor_benchmarking":
        return new CompetitorBenchmarkingAgent(runtime);
      case "technology_validation":
        return new TechnologyValidationAgent(runtime);
      case "financial_fundamentals":
        return new FinancialFundamentalsAgent(runtime);
      case "expert_opinion_synthesis":
        return new ExpertOpinionSynthesisAgent(runtime);
      case "regulatory_monitoring":
        return new RegulatoryMonitoringAgent(runtime);
      case "hiring_trends":
        return new HiringTrendsAgent(runtime);
      case "user_growth_signals":
        return new UserGrowthSignalsAgent(runtime);
      case "pricing_intelligence":
        return new PricingIntelligenceAgent(runtime);
      default:
        throw new Error(`Unknown research agent type: ${agentType}`);
