### 2.2 Research Coordinator Logic

**File**: `src/utils/researchCoordinator.ts`

```typescript
export class ResearchCoordinator {
  /**
   * Suggests relevant agents based on query and domain
   */
  static suggestAgents(
    query: string,
    domain?: string
  ): ResearchAgentType[] {
    const suggestions: ResearchAgentType[] = [];
    const lowerQuery = query.toLowerCase();

    // Domain-based suggestions
    if (domain === "finance" || lowerQuery.match(/\b(stock|revenue|market cap|price|valuation)\b/)) {
      suggestions.push("financial_fundamentals", "market_tam_sizing");
    }

    if (domain === "technology" || lowerQuery.match(/\b(tech|software|launch|feature)\b/)) {
      suggestions.push("technology_validation", "user_growth_signals");
    }

    // Keyword-based suggestions
    if (lowerQuery.match(/\b(sentiment|opinion|perception|reputation)\b/)) {
      suggestions.push("sentiment_tracking");
    }

    if (lowerQuery.match(/\b(competitor|competition|market share|vs)\b/)) {
      suggestions.push("competitor_benchmarking");
    }

    if (lowerQuery.match(/\b(market|size|TAM|opportunity)\b/)) {
      suggestions.push("market_tam_sizing");
    }

    if (lowerQuery.match(/\b(regulation|policy|law|compliance)\b/)) {
      suggestions.push("regulatory_monitoring");
    }

    if (lowerQuery.match(/\b(expert|analyst|opinion|forecast)\b/)) {
      suggestions.push("expert_opinion_synthesis");
    }

    if (lowerQuery.match(/\b(hiring|team|growth|jobs)\b/)) {
      suggestions.push("hiring_trends");
    }

    if (lowerQuery.match(/\b(users|adoption|growth|engagement)\b/)) {
      suggestions.push("user_growth_signals");
    }

    if (lowerQuery.match(/\b(price|pricing|cost|expensive)\b/)) {
      suggestions.push("pricing_intelligence");
    }

    // Remove duplicates
    return Array.from(new Set(suggestions));
  }

  /**
   * Executes multiple research agents in parallel
   */
  static async executeMultipleAgents(
    runtime: IAgentRuntime,
    agentTypes: ResearchAgentType[],
    query: ResearchQuery
  ): Promise<ResearchResult[]> {
    const results: ResearchResult[] = [];

    // Execute agents in parallel
    const promises = agentTypes.map(async (agentType) => {
      try {
        const agent = ResearchAgentFactory.createAgent(agentType, runtime);
        return await agent.executeResearch(query);
      } catch (error) {
        console.error(`Research agent ${agentType} failed:`, error);
        return null;
      }
    });

    const settled = await Promise.allSettled(promises);

    settled.forEach((result) => {
      if (result.status === "fulfilled" && result.value) {
        results.push(result.value);
      }
    });

    return results;
  }

  /**
   * Aggregates results from multiple agents
   */
  static aggregateResults(results: ResearchResult[]): {
    summary: string;
    findings: string[];
    evidence: Evidence[];
    confidence: number;
    sources: string[];
  } {
    const allFindings: string[] = [];
    const allEvidence: Evidence[] = [];
    const allSources: string[] = [];
    let totalConfidence = 0;

    results.forEach((result) => {
      allFindings.push(...result.findings);
      allEvidence.push(...result.evidence);
      allSources.push(...result.sources);
      totalConfidence += result.confidence;
    });

    const avgConfidence = totalConfidence / results.length;

    const summary = `Completed ${results.length} research agents. Found ${allFindings.length} key insights with ${avgConfidence.toFixed(0)}% average confidence.`;

    return {
      summary,
      findings: allFindings,
      evidence: allEvidence,
      confidence: avgConfidence,
      sources: Array.from(new Set(allSources)),
    };
  }
}
```

### 2.3 Interaction Patterns

#### Pattern 1: Single Agent Research

```
User → "research sentiment_tracking for Tesla"
  ↓
Action Handler
  ↓
Parse: agentType="sentiment_tracking", query="Tesla"
  ↓
Factory creates SentimentTrackingAgent
  ↓
Agent executes research
  ↓
Returns ResearchResult
  ↓
Display to user
```

#### Pattern 2: Multi-Agent Research

```
User → "research Tesla comprehensive"
  ↓
Coordinator suggests agents:
  - sentiment_tracking
  - financial_fundamentals
  - competitor_benchmarking
  ↓
Execute all 3 in parallel
  ↓
Aggregate results
  ↓
Display combined findings
```

#### Pattern 3: Scheduled Research

```
User → "schedule research sentiment_tracking for Tesla daily"
  ↓
Create ScheduledResearch record
  ↓
Store in database
  ↓
Background scheduler (cron-like)
  ↓
At scheduled time: Execute agent
  ↓
Store result
  ↓
Update forecast evidence
  ↓
Notify user (optional)
```

